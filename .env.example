DATABASE_URL=postgres://lastpeek:lastpeek@127.0.0.1:5432/lastpeek
MEDIA_DIR=./data/media
MAX_UPLOAD_MB=50
MAX_STORAGE_MB=500
BODY_SIZE_LIMIT=55M
# Optional server-only public X source previews; unset disables quotes/replies.
X_API_BEARER_TOKEN=
# Conservative per-instance monthly request budget in USD; 0 disables lookups.
X_API_MONTHLY_BUDGET_USD=5
# Optional: otherwise generated in MEDIA_DIR/.auth-secret. Persist/back up either way.
# BETTER_AUTH_SECRET= (random secret of at least 32 characters)
# Optional: enables the author's AI second look. Never use a PUBLIC_ key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Set the public origin BEFORE npm run build (Kit 3 bakes it into the build).
# ORIGIN=https://lastpeek.example
# Compose only: use a generated hex password, not this example database password.
# POSTGRES_PASSWORD=
# Bootstrap: set SEED_EMAIL and SEED_PASSWORD before npm run db:seed.
# The development seed creates a sample thread. Never use test credentials publicly.
