{
  "name": "lastpeek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "maintenance": "node --env-file-if-exists=.env --import tsx scripts/maintenance.ts",
    "account:reset": "node --env-file-if-exists=.env --import tsx scripts/reset-password.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/contracts.test.ts",
    "test:e2e": "node --env-file-if-exists=.env --import tsx --test tests/web.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/twitter-text": "^3.1.10",
    "playwright": "^1.56.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "file-type": "^22.3.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "tsx": "^4.23.15",
    "twitter-text": "^3.1.0",
    "zod": "^4.6.7"
  }
}
