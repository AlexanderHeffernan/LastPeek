{
  "name": "lastpeek",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker",
    "pwa:generate": "node --import tsx scripts/generate-pwa.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "maintenance": "node --env-file-if-exists=.env --import tsx scripts/maintenance.ts",
    "account:reset": "node --env-file-if-exists=.env --import tsx scripts/reset-password.ts",
    "operator": "node --env-file-if-exists=.env --import tsx scripts/operator.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "browsers:install": "playwright install --with-deps chromium webkit",
    "verify:release": "node --env-file-if-exists=.env scripts/verify-release.mjs",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/contracts.test.ts tests/ai.test.ts tests/release-policy.test.mjs",
    "test:deployment": "node --test tests/deployment.test.mjs",
    "test:e2e": "node --env-file-if-exists=.env --import tsx --test tests/web.test.ts tests/x-post.test.ts tests/api-usage.test.ts tests/x-auth.test.ts tests/plans.test.ts tests/notifications.test.ts && node --env-file-if-exists=.env --import tsx --test tests/x-publishing.test.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/twitter-text": "^3.1.10",
    "@types/web-push": "^3.6.4",
    "playwright": "^1.56.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "better-auth": "^1.7.14",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "file-type": "^22.3.0",
    "openai": "^7.45.1",
    "pg": "^8.23.1",
    "phosphor-svelte": "^3.1.1",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tsx": "^4.23.15",
    "twitter-text": "^3.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  }
}
